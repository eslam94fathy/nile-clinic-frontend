{
  "name": "nile-clinic-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:styles": "node scripts/check-logical-styles.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "contracts:generate": "node scripts/contracts-generate.mjs",
    "contracts:check": "node scripts/contracts-generate.mjs --check",
    "contracts:refresh": "node scripts/contracts-refresh.mjs",
    "test:unit": "vitest run",
    "test:e2e": "next build && playwright test",
    "test:e2e:live": "next build && playwright test --config playwright.live.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:i18n && pnpm check:styles && pnpm check:contrast && pnpm contracts:check && pnpm test:unit && pnpm test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@tanstack/react-query": "5.106.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "iron-session": "9.0.1",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
