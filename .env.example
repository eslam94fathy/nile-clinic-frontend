# Copy to .env.local (git-ignored). Placeholders only; never put real secrets here.
# These settings are server-side only: never prefix them with NEXT_PUBLIC_.

# Base address of the backend API, including /api/v1. The port is the backend's APP_PORT,
# which differs per machine; check it with `docker ps`. Required.
BACKEND_API_URL=http://localhost:8080/api/v1

# Seals the session cookie: at least 32 random characters. Changing it signs everyone out. Required.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The clinic's time zone. Must match the backend's CLINIC_TIMEZONE. Optional; this is the default.
CLINIC_TIMEZONE=Africa/Cairo

# Shows the design system preview at /ar/design-preview and /en/design-preview, using synthetic data.
# Optional; true or false. Leave it unset in production, where the address then behaves like any unknown one.
# DESIGN_PREVIEW_ENABLED=true

# A synthetic administrator, used only by `pnpm test:e2e:live` to create its own test accounts. Never a real person.
# LIVE_ADMIN_EMAIL=synthetic.admin@example.test
# LIVE_ADMIN_PASSWORD=replace-with-its-password
