# Copy to frontend.env, which must never be committed, and fill in from the clinic's secret store.
# Each is checked when the server starts; it stops with a message naming any that is missing or wrong.

# The backend inside its Docker network, including /api/v1.
BACKEND_API_URL=http://web/api/v1
# At least 32 random characters. Changing it signs everyone out.
SESSION_SECRET=replace-with-32-or-more-random-characters
# Must match the backend's CLINIC_TIMEZONE (hazard H4).
CLINIC_TIMEZONE=Africa/Cairo
# Leave unset in production.
# DESIGN_PREVIEW_ENABLED=
